# -------------------------------------------------------
# DataProcess Flow — Local Environment Configuration
# -------------------------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# The .env file is ignored by git (see .gitignore).
# -------------------------------------------------------

# Flask session secret — change this to any long random string
SESSION_SECRET=change-me-to-a-long-random-secret

# -------------------------------------------------------
# SMTP Email Settings (required for emails to send)
# -------------------------------------------------------
# Your outgoing mail server address
SMTP_HOST=mail.3consult-ng.com

# SMTP port (587 = STARTTLS, 465 = SSL)
SMTP_PORT=587

# Email account used to send emails
SMTP_USERNAME=support@3consult-ng.com

# Password for the sending email account
SMTP_PASSWORD=your-email-password-here

# Use STARTTLS on port 587 (true/false)
SMTP_USE_TLS=true

# Use SSL on port 465 instead of STARTTLS (true/false)
SMTP_USE_SSL=false

# -------------------------------------------------------
# Optional Email Overrides
# -------------------------------------------------------
# The "From" address shown to recipients
FROM_EMAIL=support@3consult-ng.com

# The "From" name shown to recipients
FROM_NAME=DataProcess Flow

# BCC address to receive a copy of every outgoing email
BCC_EMAIL=odada@3consult-ng.com
